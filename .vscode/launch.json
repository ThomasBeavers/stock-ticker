	"version": "0.2.0",
	"configurations": [
		{
			"name": "Start",
			"type": "node",
			"request": "launch",
			"args": [
				"src/index.ts"
			],
			"runtimeArgs": [
				"--nolazy",
				"-r",
				"ts-node/register"
			],
			"sourceMaps": true,
			"cwd": "${workspaceRoot}",
			"protocol": "inspector"
		},
		{
			"name": "Positions",
			"type": "node",
			"request": "launch",
			"args": [
				"src/index.ts",
				"positions"
			],
			"runtimeArgs": [
				"--nolazy",
				"-r",
				"ts-node/register"
			],
			"sourceMaps": true,
			"cwd": "${workspaceRoot}",
			"protocol": "inspector"
		}
	]
}